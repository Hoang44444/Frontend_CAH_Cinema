# Bản build cho Playwright (vite build --mode e2e). Để trống API base để /api đi
# cùng origin: tầng mock chặn bằng page.route, tầng e2e đi qua proxy của vite preview.
VITE_API_BASE_URL=
VITE_BASE_PATH=/
# Backend của stack E2E (e2e/stack), tách khỏi backend dev ở cổng 8080.
VITE_PROXY_TARGET=http://localhost:8081
