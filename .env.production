# Dùng cho `npm run build`. Bản build production gọi thẳng backend đã deploy.
# Backend nằm ở subdomain cinema.* — KHÔNG trỏ về mhoang26ct.online, vì domain gốc là
# GitHub Pages (chính trang này), chỉ phục vụ GET/HEAD nên POST/PUT/DELETE trả 405.
VITE_API_BASE_URL=https://cinema.mhoang26ct.online
# Custom domain mhoang26ct.online phục vụ site ở gốc domain, không phải /<tên repo>/.
VITE_BASE_PATH=/
